<?xml version="1.0" encoding="utf-8"?>
<!-- Back up the sync pairing only. WebView HTTP cache and databases stay out of the backup. -->
<full-backup-content>
    <include domain="sharedpref" path="fefc_sync.xml"/>
    <exclude domain="sharedpref" path="fefc.xml"/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
