<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup: sync pairing only. WebView storage is not backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="fefc_sync.xml"/>
        <exclude domain="sharedpref" path="fefc.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="fefc_sync.xml"/>
        <exclude domain="sharedpref" path="fefc.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
