<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup: sync pairing only. WebView storage is not backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="fefc_sync.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="fefc_sync.xml"/>
    </device-transfer>
</data-extraction-rules>
