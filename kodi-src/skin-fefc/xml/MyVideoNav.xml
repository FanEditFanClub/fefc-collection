<?xml version="1.0" encoding="UTF-8"?>
<!-- FEFC library / add-on view inside the 5% TV-safe margin (96..1824 x 54..1026).
     0.3.22: every grid is 6 tiles wide. Views 500 and 501 are the same panel: a folder is a landscape card, a video is a portrait poster. The cell height does not follow the focused item. -->
<window id="25">
	<defaultcontrol always="true">501</defaultcontrol>
	<onload>Container.SetViewMode(501)</onload>
	<!-- 0.5.0: black background on every screen -->
	<backgroundcolor>FF000000</backgroundcolor>
	<!-- One panel only. A second panel with the same items drew every poster twice. -->
	<views>501</views>
	<controls>
		<!-- Outside the content zoom. Inside it, a videowindow parked at a negative x is scaled back onto the left edge. -->
		<include>FefcWallKeep</include>
		<control type="group">
			<include>FefcContentZoom</include>
		<control type="image">
			<left>96</left><top>54</top><width>220</width><height>56</height>
			<texture>fefc-wordmark.png</texture>
			<aspectratio>keep</aspectratio>
		</control>
		<control type="image">
			<left>330</left><top>66</top><width>32</width><height>32</height>
			<texture>fefc-star.png</texture>
			<aspectratio>keep</aspectratio>
			<visible>String.IsEqual(Container.PluginCategory,My List)</visible>
		</control>
		<control type="label">
			<left>336</left><top>54</top><width>1000</width><height>56</height>
			<aligny>center</aligny>
			<font>font13_title</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$VAR[FefcHeader]</label>
			<scroll>true</scroll>
			<visible>!String.IsEqual(Container.PluginCategory,My List)</visible>
		</control>
		<control type="label">
			<left>372</left><top>54</top><width>964</width><height>56</height>
			<aligny>center</aligny>
			<font>font13_title</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$VAR[FefcHeader]</label>
			<scroll>true</scroll>
			<visible>String.IsEqual(Container.PluginCategory,My List)</visible>
		</control>
		<!-- The only grid. It stays visible even when Container.Viewmode is not 501. -->
		<include content="FefcBrowser"><param name="id" value="501"/></include>
		<control type="scrollbar" id="60">
			<left>1806</left><top>130</top><width>10</width><height>750</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>501</onleft>
		</control>
			</control>
		<!-- footer: full title of the focused item + position -->
		<control type="label">
			<left>96</left><top>954</top><width>1200</width><height>32</height>
			<aligny>center</aligny>
			<font>font10</font>
			<textcolor>FF99CCFF</textcolor>
			<label>$INFO[ListItem.Label]</label>
			<scroll>true</scroll>
		</control>
		<control type="label">
			<right>96</right><top>954</top><width>500</width><height>32</height>
			<align>right</align><aligny>center</aligny>
			<font>font10</font>
			<textcolor>FFFF9C00</textcolor>
			<label>$VAR[FefcCount]</label>
		</control>
		<include content="FefcTopBar"><param name="down" value="500"/><param name="up" value="500"/></include>
		<include>FefcTicker</include>
	</controls>
</window>
