<?xml version="1.0" encoding="UTF-8"?>
<!-- FEFC library / add-on view inside the 5% TV-safe margin (96..1824 x 54..1026).
     0.3.22: every grid is 6 tiles wide. View 500: landscape tiles (collections, genres). View 501: portrait posters (video files). -->
<window id="25">
	<defaultcontrol always="true">500</defaultcontrol>
	<!-- 0.5.0: black background on every screen -->
	<backgroundcolor>FF000000</backgroundcolor>
	<views>500,501</views>
	<controls>
		<control type="group">
			<include>FefcContentZoom</include>
		<control type="image">
			<left>96</left><top>54</top><width>220</width><height>56</height>
			<texture>fefc-wordmark.png</texture>
			<aspectratio>keep</aspectratio>
		</control>
		<control type="label">
			<left>336</left><top>54</top><width>1000</width><height>56</height>
			<aligny>center</aligny>
			<font>font13_title</font>
			<textcolor>FFFFFFFF</textcolor>
			<label>$VAR[FefcHeader]</label>
			<scroll>true</scroll>
		</control>
		<!-- landscape tiles -->
		<control type="panel" id="500">
			<visible>!Container.Content(movies)</visible>
			<left>96</left><top>122</top><width>1700</width><height>760</height>
			<onleft>500</onleft><onright>60</onright>
			<onup>9290</onup>
			<ondown>9290</ondown>
			<viewtype label="31102">icon</viewtype>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<orientation>vertical</orientation>
			<itemlayout width="283" height="150">
				<control type="group">
					<left>10</left><top>8</top>
					<include content="FefcGridTile"></include>
				</control>
			</itemlayout>
			<focusedlayout width="283" height="150">
				<control type="group">
					<left>10</left><top>8</top>
					<depth>DepthContentPopout</depth>
					<animation effect="zoom" start="100" end="104" time="180" tween="sine" easing="inout" center="132,69" reversible="true">Focus</animation>
					<include content="FefcGridTile">
						<param name="focused" value="true" />
					</include>
				</control>
			</focusedlayout>
		</control>
		<!-- portrait posters -->
		<control type="panel" id="501">
			<visible>Container.Content(movies)</visible>
			<left>96</left><top>122</top><width>1700</width><height>760</height>
			<onleft>501</onleft><onright>60</onright>
			<onup>9290</onup>
			<ondown>9290</ondown>
			<viewtype label="31102">icon</viewtype>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<orientation>vertical</orientation>
			<!-- 0.3.22: folders / tools / docs inside a list that also has files keep their landscape card -->
			<!-- 0.4.2: folder rows are 150px like view 500 (a 138px card in a 430px slot left ~292px of dead space between folder rows) -->
			<itemlayout width="283" height="150" condition="ListItem.IsFolder | !String.IsEqual(ListItem.Property(IsPlayable),true)">
				<control type="group">
					<left>9</left><top>8</top>
					<include content="FefcGridTile"></include>
				</control>
			</itemlayout>
			<focusedlayout width="283" height="150" condition="ListItem.IsFolder | !String.IsEqual(ListItem.Property(IsPlayable),true)">
				<control type="group">
					<left>9</left><top>8</top>
					<depth>DepthContentPopout</depth>
					<animation effect="zoom" start="100" end="104" time="180" tween="sine" easing="inout" center="132,69" reversible="true">Focus</animation>
					<include content="FefcGridTile">
						<param name="focused" value="true" />
					</include>
				</control>
			</focusedlayout>
			<itemlayout width="283" height="430">
				<control type="group">
					<left>30</left><top>8</top>
					<include content="FefcPosterTile"></include>
				</control>
			</itemlayout>
			<focusedlayout width="283" height="430">
				<control type="group">
					<left>30</left><top>8</top>
					<depth>DepthContentPopout</depth>
					<animation effect="zoom" start="100" end="105" time="180" tween="sine" easing="inout" center="111,166" reversible="true">Focus</animation>
					<include content="FefcPosterTile">
						<param name="focused" value="true" />
					</include>
				</control>
			</focusedlayout>
		</control>
		<control type="scrollbar" id="60">
			<left>1806</left><top>130</top><width>10</width><height>750</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>500</onleft>
		</control>
			</control>
		<!-- footer: full title of the focused item + position -->
		<control type="label">
			<left>96</left><top>954</top><width>1200</width><height>32</height>
			<aligny>center</aligny>
			<font>font10</font>
			<textcolor>FF99CCFF</textcolor>
			<label>$INFO[ListItem.Label]</label>
			<scroll>true</scroll>
		</control>
		<control type="label">
			<right>96</right><top>954</top><width>500</width><height>32</height>
			<align>right</align><aligny>center</aligny>
			<font>font10</font>
			<textcolor>FFFF9C00</textcolor>
			<label>$INFO[Container.NumItems] items   $INFO[Container.CurrentPage,page ,/]$INFO[Container.NumPages]</label>
		</control>
		<include content="FefcTopBar"><param name="down" value="500"/><param name="up" value="500"/></include>
		<include>FefcTicker</include>
	</controls>
</window>
