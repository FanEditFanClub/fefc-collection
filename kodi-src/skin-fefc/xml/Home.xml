		<!-- Full-frame mosaic. The black panel below covers the 3x3 so clips only show in the margins. -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture fallback="fefc-bg.jpg">fefc-wall-still.jpg</texture>
			<aspectratio>scale</aspectratio>
		</control>
		<control type="videowindow">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<visible>!String.IsEmpty(Window(Home).Property(FEFC.Wall)) + Player.HasVideo</visible>
		</control>
		<!-- Tap guard: image controls do not receive clicks, so a press on the mosaic fullscreened
		     the wall player (black centre, then a restart). This button swallows the click and
		     returns focus to the menu. It is not in the remote chain. -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture fallback="fefc-bg.jpg">fefc-wall-still.jpg</texture>
