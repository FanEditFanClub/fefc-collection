<?xml version="1.0" encoding="UTF-8"?>
<!-- FEFC home: 3x3 tile menu like the Fan Edit Fan Club web app home. Everything sits inside a 5% TV-safe margin (96..1824 x 54..1026). -->
<window>
	<defaultcontrol>9005</defaultcontrol>
