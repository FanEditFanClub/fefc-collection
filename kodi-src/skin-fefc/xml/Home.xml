			<control type="image">
				<left>786</left><top>430</top><width>44</width><height>44</height>
				<texture>fefc-star.png</texture><aspectratio>keep</aspectratio>
			</control>
		</control>

		<!-- utility strip: resume/stop (only while a video is paused), app update -->
		<control type="grouplist" id="9100">
			<left>152</left><top>814</top><width>1616</width><height>60</height>
			<orientation>horizontal</orientation>
			<align>center</align>
			<itemgap>20</itemgap>
			<control type="button" id="9021">
				<width>420</width><height>60</height>
				<include>FefcSmallButton</include>
				<label>RESUME: $INFO[Window(Home).Property(FEFC.PausedTitle)]</label>
				<visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
				<onleft>9023</onleft><onright>9022</onright><onup>9008</onup><ondown>9291</ondown>
				<onclick>ActivateWindow(fullscreenvideo)</onclick>
			</control>
			<control type="button" id="9022">
				<width>200</width><height>60</height>
				<include>FefcSmallButton</include>
				<label>STOP</label>
				<visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
				<onleft>9021</onleft><onright>9023</onright><onup>9008</onup><ondown>9291</ondown>
				<onclick>PlayerControl(Stop)</onclick>
			</control>
			<control type="label">
				<width>110</width><height>60</height>
				<label>NEW</label>
				<font>font12_title</font>
				<textcolor>FFFF9900</textcolor>
				<align>right</align><aligny>center</aligny>
				<visible>!String.IsEmpty(Window(Home).Property(FEFC.UpdateAvail))</visible>
			</control>
			<control type="button" id="9023">
				<width>760</width><height>60</height>
				<include>FefcSmallButton</include>
				<label>$INFO[Window(Home).Property(FEFC.UpdateLabel)]</label>
				<textcolor>FFFFFFFF</textcolor>
				<onleft>9022</onleft><onright>9021</onright><onup>9008</onup><ondown>9291</ondown>
				<onclick>RunPlugin(plugin://plugin.video.fefc/?action=update)</onclick>
			</control>
		</control>

		<include>FefcTicker</include>
		<!-- notices -->
		<control type="label">
			<left>96</left><top>900</top><width>1728</width><height>30</height>
			<align>center</align><aligny>center</aligny>
			<font>font10</font>
			<textcolor>FF7F8FA6</textcolor>
			<label>FEFC is an unofficial community app built on Kodi (GPL-2.0-or-later). Not affiliated with the Kodi Foundation.</label>
		</control>
		<control type="label">
			<left>96</left><top>936</top><width>1728</width><height>30</height>
			<align>center</align><aligny>center</aligny>
			<font>font10</font>
			<textcolor>FF99CCFF</textcolor>
			<label>OK to open  -  Back to return  -  Menu for options</label>
		</control>
		<!-- black splash: hides the home screen until the FEFC intro has played (service sets FEFC.Ready) -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF000000">colors/white.png</texture>
			<visible>String.IsEmpty(Window(Home).Property(FEFC.Ready))</visible>
			<animation effect="fade" start="100" end="0" time="200" delay="180000" condition="String.IsEmpty(Window(Home).Property(FEFC.Ready))">Conditional</animation>
		</control>
		<include content="FefcTopBar"><param name="down" value="9005"/><param name="up" value="9023"/></include>
	</controls>
</window>
