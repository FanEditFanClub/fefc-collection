				<wrapmultiline>true</wrapmultiline>
				<onleft>9001</onleft><onright>9003</onright><onup>9291</onup><ondown>9005</ondown>
				<onclick>ActivateWindow(Videos,plugin://plugin.video.fefc/?action=recent,return)</onclick>
			</control>
			<control type="button" id="9003">
				<left>1088</left><top>0</top><width>528</width><height>190</height>
