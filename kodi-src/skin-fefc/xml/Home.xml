				<label></label>
				<wrapmultiline>true</wrapmultiline>
				<onleft>9004</onleft><onright>9006</onright><onup>9002</onup><ondown>9008</ondown>
				<onclick>ActivateWindow(Videos,plugin://plugin.video.fefc/?action=folder,return)</onclick>
			</control>
			<control type="image">
				<left>544</left><top>216</top><width>528</width><height>96</height>
				<texture>fefc-logo.png</texture>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="label">
				<left>544</left><top>312</top><width>528</width><height>40</height>
				<align>center</align><aligny>center</aligny>
				<font>font12_title</font>
				<textcolor>FFFF9C00</textcolor>
				<label>MAIN COLLECTION</label>
			</control>
			<control type="button" id="9006">
				<left>1088</left><top>206</top><width>528</width><height>190</height>
