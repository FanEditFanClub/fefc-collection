<?xml version="1.0" encoding="UTF-8"?>
<!-- FEFC details page: everything is inside the 5% TV-safe margin (96..1824 x 54..1026); long text scrolls instead of being cut off. -->
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<!-- 0.5.0: black background on every screen -->
	<backgroundcolor>FF000000</backgroundcolor>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="E6000000">colors/white.png</texture>
		</control>
		<control type="group">
			<include>FefcContentZoom</include>
		<!-- LCARS frame like the web app's details page: black panel, orange elbows, coloured bars -->
		<control type="image"><left>96</left><top>54</top><width>1728</width><height>972</height><texture colordiffuse="FF000000">colors/white.png</texture></control>
		<control type="image"><left>96</left><top>54</top><width>220</width><height>120</height><texture colordiffuse="FFFF9C00">fefc-lc-elbow-top.png</texture></control>
		<control type="image"><left>322</left><top>54</top><width>560</width><height>40</height><texture colordiffuse="FFFF9C00">colors/white.png</texture></control>
		<control type="image"><left>888</left><top>54</top><width>300</width><height>40</height><texture colordiffuse="FFCC99FF">colors/white.png</texture></control>
		<control type="image"><left>1194</left><top>54</top><width>580</width><height>40</height><texture colordiffuse="FF99CCFF">colors/white.png</texture></control>
		<control type="image"><left>1780</left><top>54</top><width>44</width><height>40</height><texture border="20,0,0,0" colordiffuse="FFFF7AA2">fefc-lc-pill.png</texture></control>
		<control type="image"><left>96</left><top>180</top><width>170</width><height>660</height><texture colordiffuse="FFCC99FF">colors/white.png</texture></control>
		<control type="image"><left>96</left><top>906</top><width>220</width><height>120</height><texture colordiffuse="FFFF9C00">fefc-lc-elbow-bot.png</texture></control>
		<control type="image"><left>96</left><top>846</top><width>170</width><height>54</height><texture colordiffuse="FF33CCBB">colors/white.png</texture></control>
		<control type="image"><left>322</left><top>986</top><width>900</width><height>40</height><texture colordiffuse="FFFF9C00">colors/white.png</texture></control>
		<control type="image"><left>1228</left><top>986</top><width>596</width><height>40</height><texture colordiffuse="FFFFCC66">colors/white.png</texture></control>
		<!-- 0.4.2: the FEFC + year labels that sat on the left purple bar are removed. -->
		<!-- poster -->
		<control type="image">
			<left>300</left><top>120</top><width>330</width><height>495</height>
			<texture fallback="DefaultVideo.png">$VAR[FefcPosterArt]</texture>
			<aspectratio aligny="top">keep</aspectratio>
		</control>
		<!-- title: wraps over up to 3 lines instead of being cut off or scrolled.
		     0.5.1: no autoscroll — the full title must be visible at once. Box is 150px (3 lines
		     at 44px); year / rating / director / plot all shift down to make room. -->
		<control type="textbox">
			<left>660</left><top>84</top><width>1120</width><height>150</height>
			<font>lcars_title_sm</font>
			<textcolor>FFFFFFFF</textcolor>
			<aligny>center</aligny>
			<label>$INFO[ListItem.Title]</label>
		</control>
		<control type="label">
			<left>660</left><top>238</top><width>750</width><height>40</height>
			<aligny>center</aligny>
			<font>lcars_med</font>
			<textcolor>FFFF9C00</textcolor>
			<label>$INFO[ListItem.Year]$INFO[ListItem.Duration,   ,]$INFO[ListItem.Genre,   ,]</label>
		</control>
		<!-- 0.4.2: rating with its source, always labelled, with the source badge icon next to it.
		     (The old header showed a bare number with no source.) -->
		<control type="group">
			<left>1420</left><top>238</top><width>360</width><height>40</height>
			<visible>!String.IsEmpty(ListItem.Property(fefc_rating_src))</visible>
			<control type="image">
				<left>0</left><top>4</top><width>64</width><height>32</height>
				<texture>$INFO[ListItem.Property(fefc_rating_src),fefc-ic-,.png]</texture>
			</control>
			<control type="label">
				<left>72</left><top>0</top><width>288</width><height>40</height>
				<aligny>center</aligny>
				<font>lcars_med</font>
				<textcolor>FFFF9C00</textcolor>
				<label>$INFO[ListItem.Property(fefc_rating_text)]</label>
			</control>
		</control>
		<control type="label">
			<left>660</left><top>280</top><width>1120</width><height>36</height>
			<aligny>center</aligny>
			<font>font12</font>
			<textcolor>FF99CCFF</textcolor>
			<label>$INFO[ListItem.Director,Directed by: ]$INFO[ListItem.Studio,   Edited by: ]</label>
		</control>
		<!-- plot: fixed box, scrolls automatically and with up/down when longer -->
		<!-- 0.5.1: plot moved down (290 -> 320) and shortened (288 -> 250) to make room for the 3-line title -->
		<control type="textbox">
			<left>660</left><top>320</top><width>1100</width><height>250</height>
			<font>font13</font>
			<textcolor>FFE8EEF6</textcolor>
			<pagecontrol>61</pagecontrol>
			<autoscroll delay="4000" time="2500" repeat="6000">true</autoscroll>
			<label>$INFO[ListItem.Plot]</label>
		</control>
		<control type="scrollbar" id="61">
			<left>1770</left><top>320</top><width>8</width><height>250</height>
			<onleft>8</onleft><onright>8</onright>
			<showonepage>false</showonepage>
			<orientation>vertical</orientation>
		</control>
		<!-- cast -->
		<control type="label">
			<left>660</left><top>586</top><width>600</width><height>30</height>
			<aligny>center</aligny>
			<font>lcars_med</font>
			<textcolor>FFFF9C00</textcolor>
			<label>CAST</label>
			<visible>!String.IsEmpty(ListItem.Cast)</visible>
		</control>
		<!-- 0.3.22: full cast, no auto-scroll: 3 columns in the free space on the right, manual scroll (focus + up/down) if it overflows -->
		<control type="list" id="62">
			<left>660</left><top>620</top><width>1120</width><height>108</height>
			<scrolltime>200</scrolltime>
			<onup>9290</onup><ondown>5000</ondown>
			<itemlayout width="1120" height="36"><control type="label"><left>0</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><left>375</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Label2]</label></control><control type="label"><left>750</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Property(c3)]</label></control></itemlayout>
			<focusedlayout width="1120" height="36"><control type="image"><left>0</left><top>2</top><width>1120</width><height>32</height><texture border="12" colordiffuse="66FF9C00">fefc-ol-focus.png</texture></control><control type="label"><left>0</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><left>375</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Label2]</label></control><control type="label"><left>750</left><width>365</width><height>36</height><font>lcars_small</font><textcolor>FFFFFFFF</textcolor><selectedcolor>FFFFFFFF</selectedcolor><label>$INFO[ListItem.Property(c3)]</label></control></focusedlayout>
			<content>plugin://plugin.video.fefc/?action=castrows&amp;id=$INFO[ListItem.Property(fefc_id)]</content>
		</control>
		<!-- buttons: row 1 (Play / Resume / My List / Trailer), row 2 (Open in VLC / Open in Drive / Close) -->
		<!-- 0.4.2: rows moved up (818 -> 736, 906 -> 824) so row 2 is no longer hidden behind the bottom bar -->
		<control type="grouplist" id="5000">
			<left>660</left><top>736</top><width>1120</width><height>76</height>
			<orientation>horizontal</orientation>
			<itemgap>16</itemgap>
			<onleft>5000</onleft><onright>5000</onright><onup>62</onup><ondown>5001</ondown>
			<control type="button" id="8">
				<width>190</width><height>76</height>
				<label>$LOCALIZE[208]</label>
				<include>FefcDetailTile</include>
			</control>
			<control type="button" id="9">
				<width>190</width><height>76</height>
				<label>$LOCALIZE[13404]</label>
				<include>FefcDetailTile</include>
				<!-- 0.4.2: Resume only shows when the video was played before (the addon only sets a resume
				     point after 30s in); without this the button sat there greyed out on every new video. -->
				<visible>!String.IsEmpty(ListItem.ResumeTime)</visible>
			</control>
			<!-- 0.4.0: same star icon as the Home 'My List' tile, left of the label -->
			<!-- 0.4.2: widened 340 -> 380 so "Remove from My List" is not clipped at 27px + 40px offset -->
			<control type="group">
				<width>380</width><height>76</height>
				<visible>!String.IsEmpty(ListItem.Property(fefc_id))</visible>
				<control type="button" id="12">
					<left>0</left><top>0</top><width>380</width><height>76</height>
					<label>$VAR[FefcMyLabel]</label>
					<include>FefcDetailTile</include>
					<textoffsetx>40</textoffsetx>
					<onclick>RunPlugin(plugin://plugin.video.fefc/?action=mylist_toggle&amp;id=$INFO[ListItem.Property(fefc_id)])</onclick>
				</control>
				<control type="image">
					<left>24</left><top>21</top><width>34</width><height>34</height>
					<texture>fefc-star.png</texture><aspectratio>keep</aspectratio>
				</control>
			</control>
			<control type="button" id="11">
				<width>190</width><height>76</height>
				<label>$LOCALIZE[20410]</label>
				<include>FefcDetailTile</include>
			</control>
		</control>
		<control type="grouplist" id="5001">
			<left>660</left><top>824</top><width>1120</width><height>76</height>
			<orientation>horizontal</orientation>
			<itemgap>16</itemgap>
			<onleft>5001</onleft><onright>5001</onright><onup>5000</onup><ondown>5001</ondown>
			<control type="button" id="13">
				<width>300</width><height>76</height>
				<label>OPEN IN VLC</label>
				<include>FefcDetailTile</include>
				<onclick>RunPlugin(plugin://plugin.video.fefc/?action=open_vlc&amp;id=$INFO[ListItem.Property(fefc_id)])</onclick>
				<visible>!String.IsEmpty(ListItem.Property(fefc_id))</visible>
			</control>
			<control type="button" id="14">
				<width>300</width><height>76</height>
				<label>OPEN IN DRIVE</label>
				<include>FefcDetailTile</include>
				<onclick>RunPlugin(plugin://plugin.video.fefc/?action=open_drive&amp;id=$INFO[ListItem.Property(fefc_id)])</onclick>
				<visible>!String.IsEmpty(ListItem.Property(fefc_id))</visible>
			</control>
			<!-- 0.5.1: no fallback — add_video() always sets fefc_download_label, and the ',Download'
			     fallback was rendering a second "Download" next to it ("Download Download"). -->
			<control type="button" id="15">
				<width>300</width><height>76</height>
				<label>$INFO[ListItem.Property(fefc_download_label)]</label>
				<include>FefcDetailTile</include>
				<onclick>RunPlugin(plugin://plugin.video.fefc/?action=download&amp;id=$INFO[ListItem.Property(fefc_id)])</onclick>
				<visible>!String.IsEmpty(ListItem.Property(fefc_id))</visible>
			</control>
		</control>
		<control type="image">
			<left>300</left><top>640</top><width>330</width><height>90</height>
			<texture>fefc-wordmark.png</texture>
			<aspectratio>keep</aspectratio>
		</control>
			</control>
		<include content="FefcTopBar"><param name="down" value="8"/><param name="up" value="8"/></include>
		<include>FefcTicker</include>
		<include>FefcWallKeep</include>
	</controls>
</window>
