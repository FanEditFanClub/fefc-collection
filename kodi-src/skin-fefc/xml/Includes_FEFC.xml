<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="FefcTileArt">
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="FefcHeader">
		<value condition="!String.IsEmpty(Container.PluginCategory)">$INFO[Container.PluginCategory]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="FefcPosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<!-- Home tile button look -->
	<include name="FefcTile">
		<texturenofocus border="26">fefc-tile.png</texturenofocus>
		<texturefocus border="26">fefc-tile-focus.png</texturefocus>
		<font>font_tile</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<animation effect="zoom" start="100" end="104" time="160" tween="sine" easing="inout" center="auto">Focus</animation>
		<animation effect="zoom" start="104" end="100" time="160" tween="sine" easing="inout" center="auto">UnFocus</animation>
	</include>
	<!-- One grid tile (366x198 slot; 346x180 visible) -->
	<include name="FefcGridTile">
		<definition>
			<control type="image">
				<width>346</width><height>180</height>
				<texture border="26">fefc-tile.png</texture>
			</control>
			<control type="image">
				<left>6</left><top>6</top><width>334</width><height>168</height>
				<texture fallback="DefaultFolder.png">$VAR[FefcTileArt]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
			</control>
			<control type="image">
				<left>6</left><top>84</top><width>334</width><height>90</height>
				<texture>fefc-shade.png</texture>
			</control>
			<control type="label">
				<left>16</left><top>130</top><width>314</width><height>40</height>
				<aligny>center</aligny>
				<font>font12_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<scroll>true</scroll>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="label">
				<left>16</left><top>130</top><width>314</width><height>40</height>
				<aligny>center</aligny>
				<font>font12_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!$PARAM[focused]</visible>
			</control>
			<control type="label">
				<right>18</right><top>12</top><width>200</width><height>30</height>
				<align>right</align><aligny>center</aligny>
				<font>font10</font>
				<textcolor>FFFF9C00</textcolor>
				<label>$INFO[ListItem.Year]</label>
			</control>
			<control type="image">
				<width>346</width><height>180</height>
				<texture border="26">fefc-tile-ring.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
		</definition>
		<param name="focused" default="false" />
	</include>
	<include name="FefcDialogButton">
		<texturenofocus border="26">fefc-tile.png</texturenofocus>
		<texturefocus border="26">fefc-tile-focus.png</texturefocus>
		<font>font13_title</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
</includes>
