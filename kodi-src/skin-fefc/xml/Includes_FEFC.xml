<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="FefcTileArt">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="FefcHeader">
		<value condition="!String.IsEmpty(Container.PluginCategory)">$INFO[Container.PluginCategory]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="FefcPosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="FefcMyLabel">
		<value condition="String.IsEqual(Window(Home).Property(FEFC.MyId),ListItem.Property(fefc_id))">$INFO[Window(Home).Property(FEFC.MyLabel)]</value>
		<value>$INFO[ListItem.Property(fefc_mylabel)]</value>
	</variable>
	<!-- Home tile button look -->
	<include name="FefcTile">
		<texturenofocus border="24">fefc-ol-tile.png</texturenofocus>
		<texturefocus border="24">fefc-ol-focus.png</texturefocus>
		<font>font11_tile</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<animation effect="zoom" start="100" end="104" time="160" tween="sine" easing="inout" center="auto">Focus</animation>
		<animation effect="zoom" start="104" end="100" time="160" tween="sine" easing="inout" center="auto">UnFocus</animation>
	</include>
	<!-- Landscape tile for collections / genres (slot 425x217; visible 405x201). Art is scaled to fill a dimmed backdrop and shown whole on top. -->
	<include name="FefcGridTile">
		<definition>
			<control type="image">
				<width>265</width><height>138</height>
				<texture border="26">fefc-tile.png</texture>
			</control>
			<control type="image">
				<left>5</left><top>5</top><width>255</width><height>128</height>
				<texture fallback="DefaultFolder.png">$VAR[FefcTileArt]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<colordiffuse>66FFFFFF</colordiffuse>
			</control>
			<control type="image">
				<left>5</left><top>5</top><width>255</width><height>128</height>
				<texture fallback="DefaultFolder.png">$VAR[FefcTileArt]</texture>
				<aspectratio scalediffuse="false">keep</aspectratio>
			</control>
			<control type="image">
				<left>5</left><top>5</top><width>255</width><height>128</height>
				<texture>fefc-white.png</texture>
				<colordiffuse>8C000000</colordiffuse>
				<visible>!String.Contains(ListItem.Art(landscape),fefc-shuffle-tile) + !String.Contains(ListItem.Art(landscape),fefc-sort-tile) + !String.Contains(ListItem.Art(landscape),fefc-support-tile) + !String.Contains(ListItem.Art(landscape),fefc-readfirst-tile) + !String.Contains(ListItem.Art(landscape),fefc-tbc-tile) + !String.Contains(ListItem.Art(landscape),fefc-testing-tile)</visible>
			</control>
			<!-- A label control ellipsizes in a panel even with wrapmultiline. A textbox wraps the full name. -->
			<control type="textbox">
				<left>10</left><top>22</top><width>245</width><height>100</height>
				<align>center</align>
				<font>font_folder</font>
				<textcolor>FFFFFFFF</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!String.Contains(ListItem.Art(landscape),fefc-shuffle-tile) + !String.Contains(ListItem.Art(landscape),fefc-sort-tile) + !String.Contains(ListItem.Art(landscape),fefc-support-tile) + !String.Contains(ListItem.Art(landscape),fefc-readfirst-tile) + !String.Contains(ListItem.Art(landscape),fefc-tbc-tile) + !String.Contains(ListItem.Art(landscape),fefc-testing-tile)</visible>
			</control>
			<control type="image">
				<width>265</width><height>138</height>
				<texture border="26">fefc-tile-ring.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
		</definition>
		<param name="focused" default="false" />
	</include>
	<!-- Portrait poster tile for video files (slot 242x425): poster 222x333, two-line title below -->
	<include name="FefcPosterTile">
		<definition>
			<control type="image">
				<left>0</left><top>0</top><width>222</width><height>312</height>
				<texture border="20">fefc-tile.png</texture>
			</control>
			<control type="image">
				<left>4</left><top>4</top><width>214</width><height>304</height>
				<texture fallback="DefaultVideo.png">$VAR[FefcPosterArt]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>222</width><height>312</height>
				<texture border="20">fefc-tile-ring.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<!-- 0.5.6: 30px, three lines, centered. A label control ellipsizes inside a
			     list even with wrapmultiline, so this is a textbox. The focused tile
			     scrolls the full name instead. The block stays inside 3 grid rows
			     (shapes.SPAN) so the cells under a poster are covered, not empty. -->
			<control type="textbox">
				<left>-6</left><top>316</top><width>234</width><height>108</height>
				<align>center</align>
				<font>font13_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!$PARAM[focused]</visible>
			</control>
			<control type="label">
				<left>-6</left><top>316</top><width>234</width><height>108</height>
				<aligny>top</aligny><align>center</align>
				<font>font13_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<scroll>true</scroll>
				<scrollspeed>40</scrollspeed>
				<visible>$PARAM[focused]</visible>
			</control>
		</definition>
		<param name="focused" default="false" />
	</include>
	<!-- Both browser views include this. The cell height never changes with the
	     focused item: a folder shows the landscape card, a video shows the poster
	     (drawn down across the cells shapes.pack reserved for it), a spacer shows
	     nothing. View id and Container.Content do not choose the shape. -->
	<include name="FefcBrowser">
		<param name="id" default="501"/>
		<definition>
		<control type="panel" id="$PARAM[id]">
			<left>96</left><top>122</top><width>1700</width><height>760</height>
			<onleft>$PARAM[id]</onleft><onright>60</onright>
			<onup>9290</onup>
			<ondown>9290</ondown>
			<viewtype label="31102">icon</viewtype>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<orientation>vertical</orientation>
			<itemlayout width="283" height="150">
				<control type="group">
					<visible>!String.IsEqual(ListItem.Property(fefc_kind),video) + !String.IsEqual(ListItem.Property(fefc_kind),spacer)</visible>
					<left>10</left><top>8</top>
					<include content="FefcGridTile"></include>
				</control>
				<control type="group">
					<visible>String.IsEqual(ListItem.Property(fefc_kind),video)</visible>
					<left>30</left><top>8</top>
					<include content="FefcPosterTile"></include>
				</control>
			</itemlayout>
			<focusedlayout width="283" height="150">
				<control type="group">
					<visible>!String.IsEqual(ListItem.Property(fefc_kind),video) + !String.IsEqual(ListItem.Property(fefc_kind),spacer)</visible>
					<left>10</left><top>8</top>
					<depth>DepthContentPopout</depth>
					<animation effect="zoom" start="100" end="104" time="180" tween="sine" easing="inout" center="132,69" reversible="true">Focus</animation>
					<include content="FefcGridTile">
						<param name="focused" value="true" />
					</include>
				</control>
				<control type="group">
					<visible>String.IsEqual(ListItem.Property(fefc_kind),video)</visible>
					<left>30</left><top>8</top>
					<depth>DepthContentPopout</depth>
					<animation effect="zoom" start="100" end="105" time="180" tween="sine" easing="inout" center="111,156" reversible="true">Focus</animation>
					<include content="FefcPosterTile">
						<param name="focused" value="true" />
					</include>
				</control>
			</focusedlayout>
		</control>
		</definition>
	</include>
	<variable name="FefcCount">
		<value condition="!String.IsEmpty(Window(Home).Property(FEFC.Shown))">$INFO[Window(Home).Property(FEFC.Shown)] items   $INFO[Container.CurrentPage,page ,/]$INFO[Container.NumPages]</value>
		<value>$INFO[Container.NumItems] items   $INFO[Container.CurrentPage,page ,/]$INFO[Container.NumPages]</value>
	</variable>
	<variable name="FefcSoundLabel">
		<value condition="!String.IsEmpty(Window(Home).Property(FEFC.SoundOff))">SOUND OFF</value>
		<value>SOUND ON</value>
	</variable>
	<include name="FefcSmallButton">
		<texturenofocus border="26">fefc-tile.png</texturenofocus>
		<texturefocus border="26">fefc-tile-focus.png</texturefocus>
		<!-- 0.5.0: the bar font (20px) lives here, not overridden per button — the per-button override
		     was not reliably winning over this 27px font, so Update / Sound / Settings text rendered
		     too wide for their buttons and got cut off (4th report). One font, one place. -->
		<font>fefc_bar</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
	<!-- Video-details actions: same rectangular Home tile as the 3x3 menu. -->
	<include name="FefcDetailTile">
		<texturenofocus border="24">fefc-ol-tile.png</texturenofocus>
		<texturefocus border="24">fefc-ol-focus.png</texturefocus>
		<font>font12_title</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<disabledcolor>FF9FB6CF</disabledcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
	<include name="FefcDialogButton">
		<texturenofocus border="38" colordiffuse="FFFF9C00">fefc-lc-pill.png</texturenofocus>
		<texturefocus border="38" colordiffuse="FFFFFFFF">fefc-lc-pill.png</texturefocus>
		<!-- 0.3.22: one high-contrast text colour on every button, incl. disabled ones (Resume without a resume point) -->
		<font>lcars_btn</font>
		<textcolor>FF000000</textcolor>
		<focusedcolor>FF000000</focusedcolor>
		<disabledcolor>FF000000</disabledcolor>
		<shadowcolor>00000000</shadowcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
	<!-- Shared chrome on every FEFC page (like the web app): top bar (version, Search, Settings, About, clock) and the community ticker.
	     Pages lay their own content out between y=102 and y=978 so nothing overlaps. Hidden during fullscreen video. -->
	<!-- 0.3.22: no version / top-right menu anywhere. Every page gets the same bottom-centre rounded menu bar as Home
	     (Resume/Stop when paused, Search, Sound, Settings, About, Update). Home draws its own bar (9100), so this one hides there. -->
	<include name="FefcTopBar">
		<param name="down">noop</param>
		<param name="up">noop</param>
		<param name="show">!Window.IsActive(home) + !Window.IsActive(fullscreenvideo) + !Window.IsActive(visualisation)</param>
		<definition>
		<control type="group">
			<visible>$PARAM[show]</visible>
			<control type="image">
				<left>110</left><top>866</top><width>1700</width><height>84</height>
				<texture border="40" colordiffuse="E6101418">fefc-lc-pill.png</texture>
			</control>
			<!-- Fixed coordinates. Nested grouplist groups were collapsing HOME to the icon and the letter H. -->
			<control type="group">
				<left>110</left><top>878</top>
				<control type="button" id="9295">
					<left>16</left><top>0</top><width>170</width><height>60</height>
					<include>FefcSmallButton</include>
					<label>RESUME</label>
					<visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
					<onleft>9292</onleft><onright>9296</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>ActivateWindow(fullscreenvideo)</onclick>
				</control>
				<control type="button" id="9296">
					<left>194</left><top>0</top><width>140</width><height>60</height>
					<include>FefcSmallButton</include>
					<label>STOP</label>
					<visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
					<onleft>9295</onleft><onright>9290</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>PlayerControl(Stop)</onclick>
				</control>
			</control>
			<control type="group">
				<left>110</left><top>878</top>
				<animation effect="slide" end="165,0" time="0" condition="Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))">Conditional</animation>
				<control type="button" id="9290">
					<left>348</left><top>0</top><width>220</width><height>60</height>
					<include>FefcSmallButton</include>
					<textoffsetx>52</textoffsetx><align>left</align>
					<label>HOME</label>
					<onleft condition="Control.IsVisible(9296)">9296</onleft><onleft>9292</onleft>
					<onright>9291</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>ActivateWindow(Home)</onclick>
				</control>
				<control type="image"><left>364</left><top>16</top><width>28</width><height>28</height><texture>fefc-ic-home.png</texture></control>
				<control type="button" id="9291">
					<left>576</left><top>0</top><width>220</width><height>60</height>
					<include>FefcSmallButton</include>
					<textoffsetx>52</textoffsetx><align>left</align>
					<label>SEARCH</label>
					<onleft>9290</onleft><onright>9294</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>RunPlugin(plugin://plugin.video.fefc/?action=searchbox)</onclick>
				</control>
				<control type="image"><left>592</left><top>16</top><width>28</width><height>28</height><texture>fefc-ic-search.png</texture></control>
				<control type="button" id="9294">
					<left>804</left><top>0</top><width>270</width><height>60</height>
					<include>FefcSmallButton</include>
					<textoffsetx>52</textoffsetx><align>left</align>
					<label>$VAR[FefcSoundLabel]</label>
					<onleft>9291</onleft><onright>9292</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>RunPlugin(plugin://plugin.video.fefc/?action=sound_toggle)</onclick>
				</control>
				<control type="image"><left>820</left><top>16</top><width>28</width><height>28</height><texture>fefc-ic-sound.png</texture><visible>String.IsEmpty(Window(Home).Property(FEFC.SoundOff))</visible></control>
				<control type="image"><left>820</left><top>16</top><width>28</width><height>28</height><texture>fefc-ic-mute.png</texture><visible>!String.IsEmpty(Window(Home).Property(FEFC.SoundOff))</visible></control>
				<control type="button" id="9292">
					<left>1082</left><top>0</top><width>250</width><height>60</height>
					<include>FefcSmallButton</include>
					<textoffsetx>52</textoffsetx><align>left</align>
					<label>SETTINGS</label>
					<onleft>9294</onleft>
					<onright condition="Control.IsVisible(9295)">9295</onright><onright>9290</onright>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(501)">501</onup>
					<onup condition="!Window.IsVisible(movieinformation) + Control.IsVisible(500)">500</onup>
					<onup>$PARAM[up]</onup>
					<ondown condition="Control.IsVisible(501)">501</ondown>
					<ondown condition="Control.IsVisible(500)">500</ondown>
					<ondown>$PARAM[down]</ondown>
					<onclick>RunPlugin(plugin://plugin.video.fefc/?action=settings)</onclick>
				</control>
				<control type="image"><left>1098</left><top>16</top><width>28</width><height>28</height><texture>fefc-ic-gear.png</texture></control>
			</control>
		</control>
		</definition>
	</include>
	<include name="FefcTicker">
		<param name="top">984</param>
		<definition>
		<control type="group">
			<left>96</left><top>$PARAM[top]</top>
			<visible>!Window.IsActive(fullscreenvideo) + !Window.IsActive(visualisation)</visible>
			<control type="image">
				<left>0</left><top>0</top><width>1728</width><height>44</height>
				<texture border="20">fefc-tile.png</texture>
			</control>
			<control type="label">
				<left>22</left><top>0</top><width>1684</width><height>44</height>
				<aligny>center</aligny>
				<font>fefc_ticker</font>
				<textcolor>FFFFFFFF</textcolor>
				<scroll>true</scroll>
				<scrollspeed>48</scrollspeed>
				<!-- Keeps the marquee dirty on windows that are not redrawing a video, so My List and folders keep scrolling. -->
				<animation effect="fade" start="100" end="99" time="700" pulse="true" condition="true">Conditional</animation>
				<label>$INFO[Window(Home).Property(FEFC.Ticker)]</label>
				<visible>!String.IsEmpty(Window(Home).Property(FEFC.Ticker))</visible>
			</control>
			<control type="label">
				<left>22</left><top>0</top><width>1684</width><height>44</height>
				<aligny>center</aligny>
				<font>fefc_ticker</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>Loading community news...</label>
				<visible>String.IsEmpty(Window(Home).Property(FEFC.Ticker))</visible>
			</control>
		</control>
		</definition>
	</include>
	<!-- Off-screen player target so the home-wall loop (and its ambience) is not stopped when Home closes.
	     Home keeps the visible videowindow. A real fullscreen film uses the fullscreen window. -->
	<include name="FefcWallKeep">
		<!-- Far enough left that a 90% zoom around the screen centre cannot pull any of it on screen. -->
		<control type="videowindow">
			<left>-3200</left><top>0</top><width>480</width><height>270</height>
			<visible>!Window.IsActive(home)</visible>
		</control>
	</include>
	<!-- content of a page shrunk 90% about the centre so it sits between the top bar and the ticker -->
	<include name="FefcContentZoom">
		<animation effect="zoom" start="100" end="90" center="960,540" time="0" condition="true" type="conditional">Conditional</animation>
	</include>
</includes>
