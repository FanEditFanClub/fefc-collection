<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="FefcTileArt">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="FefcHeader">
		<value condition="!String.IsEmpty(Container.PluginCategory)">$INFO[Container.PluginCategory]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="FefcPosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="FefcMyLabel">
		<value condition="String.IsEqual(Window(Home).Property(FEFC.MyId),ListItem.Property(fefc_id))">$INFO[Window(Home).Property(FEFC.MyLabel)]</value>
		<value>$INFO[ListItem.Property(fefc_mylabel)]</value>
	</variable>
	<!-- Home tile button look -->
	<include name="FefcTile">
		<texturenofocus border="24">fefc-ol-tile.png</texturenofocus>
		<texturefocus border="24">fefc-ol-focus.png</texturefocus>
		<font>font11_tile</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<animation effect="zoom" start="100" end="104" time="160" tween="sine" easing="inout" center="auto">Focus</animation>
		<animation effect="zoom" start="104" end="100" time="160" tween="sine" easing="inout" center="auto">UnFocus</animation>
	</include>
	<!-- Landscape tile for collections / genres (slot 425x217; visible 405x201). Art is scaled to fill a dimmed backdrop and shown whole on top. -->
	<include name="FefcGridTile">
		<definition>
			<control type="image">
				<width>265</width><height>138</height>
				<texture border="26">fefc-tile.png</texture>
			</control>
			<control type="image">
				<left>5</left><top>5</top><width>255</width><height>128</height>
				<texture fallback="DefaultFolder.png">$VAR[FefcTileArt]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<colordiffuse>66FFFFFF</colordiffuse>
			</control>
			<control type="image">
				<left>5</left><top>5</top><width>255</width><height>128</height>
				<texture fallback="DefaultFolder.png">$VAR[FefcTileArt]</texture>
				<aspectratio scalediffuse="false">keep</aspectratio>
			</control>
			<control type="image">
				<left>5</left><top>58</top><width>255</width><height>75</height>
				<texture>fefc-shade.png</texture>
				<visible>!String.Contains(ListItem.Art(landscape),fefc-shuffle-tile) + !String.Contains(ListItem.Art(landscape),fefc-sort-tile) + !String.Contains(ListItem.Art(landscape),fefc-support-tile) + !String.Contains(ListItem.Art(landscape),fefc-readfirst-tile) + !String.Contains(ListItem.Art(landscape),fefc-tbc-tile) + !String.Contains(ListItem.Art(landscape),fefc-testing-tile)</visible>
			</control>
			<control type="label">
				<left>10</left><top>30</top><width>245</width><height>102</height>
				<aligny>bottom</aligny>
				<font>font_folder</font>
				<textcolor>FFFFFFFF</textcolor>
				<!-- 0.5.1: black text shadow so the name stays readable over bright/busy genre art -->
				<shadowcolor>FF000000</shadowcolor>
				<label>$INFO[ListItem.Label]</label>
				<wrapmultiline>true</wrapmultiline>
				<visible>!String.Contains(ListItem.Art(landscape),fefc-shuffle-tile) + !String.Contains(ListItem.Art(landscape),fefc-sort-tile) + !String.Contains(ListItem.Art(landscape),fefc-support-tile) + !String.Contains(ListItem.Art(landscape),fefc-readfirst-tile) + !String.Contains(ListItem.Art(landscape),fefc-tbc-tile) + !String.Contains(ListItem.Art(landscape),fefc-testing-tile) + String.IsEmpty(ListItem.Property(fefc_people))</visible>
				<!-- 0.3.22: Shuffle / Sort / Support Us art already carries the big centred label; no small duplicate -->
				<!-- Folder names: 26px bold, white, wrapping inside the 245x102 label box. Poster tiles stay on font_tile_xs. -->
			</control>
			<!-- People tiles keep the natural name, wrapped, in the same white as other labels. -->
			<control type="label">
				<left>10</left><top>30</top><width>245</width><height>102</height>
				<align>center</align><aligny>center</aligny>
				<font>font12_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label>$INFO[ListItem.Label]</label>
				<wrapmultiline>true</wrapmultiline>
				<visible>!String.IsEmpty(ListItem.Property(fefc_people))</visible>
			</control>
			<control type="image">
				<width>265</width><height>138</height>
				<texture border="26">fefc-tile-ring.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
		</definition>
		<param name="focused" default="false" />
	</include>
	<!-- Portrait poster tile for video files (slot 242x425): poster 222x333, two-line title below -->
	<include name="FefcPosterTile">
		<definition>
			<control type="image">
				<left>0</left><top>0</top><width>222</width><height>333</height>
				<texture border="20">fefc-tile.png</texture>
			</control>
			<control type="image">
				<left>4</left><top>4</top><width>214</width><height>325</height>
				<texture fallback="DefaultVideo.png">$VAR[FefcPosterArt]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>222</width><height>333</height>
				<texture border="20">fefc-tile-ring.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<!-- 0.4.2: year label removed from poster tiles -->
			<!-- 0.5.1: 15px label (was 17px) so long file names fit instead of clipping -->
			<control type="label">
				<left>-6</left><top>337</top><width>234</width><height>92</height>
				<aligny>top</aligny><align>center</align>
				<font>font_tile_xs</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<wrapmultiline>true</wrapmultiline>
			</control>
		</definition>
		<param name="focused" default="false" />
	</include>
	<variable name="FefcSoundLabel">
		<value condition="!String.IsEmpty(Window(Home).Property(FEFC.SoundOff))">SOUND OFF</value>
		<value>SOUND ON</value>
	</variable>
	<include name="FefcSmallButton">
		<texturenofocus border="16">fefc-tile.png</texturenofocus>
		<texturefocus border="16">fefc-tile-focus.png</texturefocus>
		<font>fefc_bar</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
	</include>
	<!-- Centred bar label. Kodi's max text width is control width minus textoffsetx on BOTH sides. -->
	<include name="FefcBarButton">
		<texturenofocus border="16">fefc-tile.png</texturenofocus>
		<texturefocus border="16">fefc-tile-focus.png</texturefocus>
		<font>fefc_bar</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
	</include>
	<!-- Icon on the left. textoffsetx 36 is applied twice, so the control is wider than the word. -->
	<include name="FefcBarIconButton">
		<texturenofocus border="16">fefc-tile.png</texturenofocus>
		<texturefocus border="16">fefc-tile-focus.png</texturefocus>
		<font>fefc_bar</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<textoffsetx>36</textoffsetx>
	</include>
	<!-- Video-details actions: same rectangular Home tile as the 3x3 menu. -->
	<include name="FefcDetailTile">
		<texturenofocus border="24">fefc-ol-tile.png</texturenofocus>
		<texturefocus border="24">fefc-ol-focus.png</texturefocus>
		<font>font12_title</font>
		<textcolor>FFFFFFFF</textcolor>
		<focusedcolor>FFFFFFFF</focusedcolor>
		<disabledcolor>FF9FB6CF</disabledcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
	<include name="FefcDialogButton">
		<texturenofocus border="38" colordiffuse="FFFF9C00">fefc-lc-pill.png</texturenofocus>
		<texturefocus border="38" colordiffuse="FFFFFFFF">fefc-lc-pill.png</texturefocus>
		<!-- 0.3.22: one high-contrast text colour on every button, incl. disabled ones (Resume without a resume point) -->
		<font>lcars_btn</font>
		<textcolor>FF000000</textcolor>
		<focusedcolor>FF000000</focusedcolor>
		<disabledcolor>FF000000</disabledcolor>
		<shadowcolor>00000000</shadowcolor>
		<align>center</align>
		<aligny>center</aligny>
	</include>
	<!-- Shared chrome on every FEFC page (like the web app): top bar (version, Search, Settings, About, clock) and the community ticker.
	     Pages lay their own content out between y=102 and y=978 so nothing overlaps. Hidden during fullscreen video. -->
	<!-- 0.3.22: no version / top-right menu anywhere. Every page gets the same bottom-centre rounded menu bar as Home
	     (Resume/Stop when paused, Search, Sound, Settings, About, Update). Home draws its own bar (9100), so this one hides there. -->
	<include name="FefcTopBar">
		<param name="down">noop</param>
		<param name="up">noop</param>
		<definition>
		<control type="group">
			<visible>!Window.IsActive(home) + !Window.IsActive(fullscreenvideo) + !Window.IsActive(visualisation)</visible>
			<control type="image">
				<left>387</left><top>886</top><width>1146</width><height>64</height>
				<texture border="32" colordiffuse="E6101418">fefc-lc-pill.png</texture>
			</control>
			<control type="grouplist" id="9290">
				<left>387</left><top>892</top><width>1146</width><height>52</height><align>center</align>
				<orientation>horizontal</orientation>
				<align>center</align>
				<itemgap>4</itemgap>
				<onup condition="Control.IsVisible(501)">501</onup><onup>$PARAM[down]</onup><ondown condition="Control.IsVisible(501)">501</ondown><ondown>$PARAM[down]</ondown><onleft>9290</onleft><onright>9290</onright>
				<control type="button" id="9295">
					<width>120</width><height>52</height><visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
					<include>FefcBarButton</include>
					<label>RESUME</label>
					<onclick>ActivateWindow(fullscreenvideo)</onclick>
				</control>
				<control type="button" id="9296">
					<width>90</width><height>52</height><visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(FEFC.PausedTitle))</visible>
					<include>FefcBarButton</include>
					<label>STOP</label>
					<onclick>PlayerControl(Stop)</onclick>
				</control>
				<control type="group">
					<width>151</width><height>52</height>
					<control type="button" id="9298">
						<left>0</left><top>0</top><width>151</width><height>52</height>
						<include>FefcBarIconButton</include>
						<label>HOME</label>
						<onclick>ActivateWindow(Home)</onclick>
					</control>
					<control type="image"><left>8</left><top>14</top><width>24</width><height>24</height><texture>fefc-ic-home.png</texture></control>
				</control>
				<control type="group">
					<width>165</width><height>52</height>
					<control type="button" id="9291">
						<left>0</left><top>0</top><width>165</width><height>52</height>
						<include>FefcBarIconButton</include>
						<label>SEARCH</label>
						<onclick>RunPlugin(plugin://plugin.video.fefc/?action=searchbox)</onclick>
					</control>
					<control type="image"><left>8</left><top>14</top><width>24</width><height>24</height><texture>fefc-ic-search.png</texture></control>
				</control>
				<control type="group">
					<width>208</width><height>52</height>
					<control type="button" id="9294">
						<left>0</left><top>0</top><width>208</width><height>52</height>
						<include>FefcBarIconButton</include>
						<label>$VAR[FefcSoundLabel]</label>
						<onclick>RunPlugin(plugin://plugin.video.fefc/?action=sound_toggle)</onclick>
					</control>
					<control type="image"><left>8</left><top>14</top><width>24</width><height>24</height><texture>fefc-ic-sound.png</texture><visible>String.IsEmpty(Window(Home).Property(FEFC.SoundOff))</visible></control>
					<control type="image"><left>8</left><top>14</top><width>24</width><height>24</height><texture>fefc-ic-mute.png</texture><visible>!String.IsEmpty(Window(Home).Property(FEFC.SoundOff))</visible></control>
				</control>
				<control type="group">
					<width>185</width><height>52</height>
					<control type="button" id="9292">
						<left>0</left><top>0</top><width>185</width><height>52</height>
						<include>FefcBarIconButton</include>
						<label>SETTINGS</label>
						<onclick>RunPlugin(plugin://plugin.video.fefc/?action=settings)</onclick>
					</control>
					<control type="image"><left>8</left><top>14</top><width>24</width><height>24</height><texture>fefc-ic-gear.png</texture></control>
				</control>
			</control>
		</control>
		</definition>
	</include>
	<!-- Two copies of a fixed-width line, slid by exactly that width. Native label scroll bounces; per-frame Python rewrites stutter while the wall decodes. -->
	<include name="FefcTicker">
		<param name="top">988</param>
		<definition>
		<control type="group">
			<left>0</left><top>$PARAM[top]</top>
			<visible>!Window.IsActive(fullscreenvideo) + !Window.IsActive(visualisation) + String.IsEmpty(Window(Home).Property(FEFC.Intro))</visible>
			<control type="image">
				<left>96</left><top>0</top><width>1728</width><height>44</height>
				<texture border="20">fefc-tile.png</texture>
			</control>
			<control type="group">
				<left>118</left><top>0</top>
				<animation effect="slide" start="0,0" end="-16000,0" time="200000" tween="linear" loop="true" condition="!String.IsEmpty(Window(Home).Property(FEFC.Ticker))">Conditional</animation>
				<control type="label">
					<left>0</left><top>0</top><width>16100</width><height>44</height>
					<align>left</align><aligny>center</aligny>
					<font>fefc_ticker</font>
					<textcolor>FFFFFFFF</textcolor>
					<scroll>false</scroll>
					<label>$INFO[Window(Home).Property(FEFC.Ticker)]</label>
					<visible>!String.IsEmpty(Window(Home).Property(FEFC.Ticker))</visible>
				</control>
				<control type="label">
					<left>16000</left><top>0</top><width>16100</width><height>44</height>
					<align>left</align><aligny>center</aligny>
					<font>fefc_ticker</font>
					<textcolor>FFFFFFFF</textcolor>
					<scroll>false</scroll>
					<label>$INFO[Window(Home).Property(FEFC.Ticker)]</label>
					<visible>!String.IsEmpty(Window(Home).Property(FEFC.Ticker))</visible>
				</control>
			</control>
			<control type="label">
				<left>118</left><top>0</top><width>1684</width><height>44</height>
				<aligny>center</aligny>
				<font>fefc_ticker</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>Loading community news...</label>
				<visible>String.IsEmpty(Window(Home).Property(FEFC.Ticker))</visible>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>96</width><height>44</height>
				<texture colordiffuse="FF000000">colors/white.png</texture>
			</control>
			<control type="image">
				<left>1824</left><top>0</top><width>96</width><height>44</height>
				<texture colordiffuse="FF000000">colors/white.png</texture>
			</control>
		</control>
		</definition>
	</include>
	<!-- content of a page shrunk 90% about the centre so it sits between the top bar and the ticker -->
	<include name="FefcContentZoom">
		<animation effect="zoom" start="100" end="90" center="960,540" time="0" condition="true" type="conditional">Conditional</animation>
	</include>
</includes>
