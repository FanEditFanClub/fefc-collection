<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.fefc" name="Fan Edit Fan Club Repository" version="1.0.0" provider-name="Fan Edit Fan Club">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Fan Edit Fan Club Repository">
    <dir>
      <info compressed="false">https://fefc-collection.pages.dev/kodi-repo/addons.xml</info>
      <checksum>https://fefc-collection.pages.dev/kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://fefc-collection.pages.dev/kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Fan Edit Fan Club add-on repository</summary>
    <description lang="en_GB">Installs and automatically updates the Fan Edit Fan Club Collection add-on for Kodi.</description>
    <platform>all</platform>
    <license>Fan project</license>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
