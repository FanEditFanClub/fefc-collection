<?xml version="1.0" encoding="UTF-8"?>
<!-- Back is PreviousMenu and nothing else. The old keymap ran a plugin call and
     then Back, which re-entered this file and Kodi dropped the key, so the Fire
     TV remote did nothing. Do not call a plugin from back.
     The menu key and a long-press of Select open the FEFC menu, which has no
     Add to favourites / Remove from favourites entry. -->
<keymap>
	<global>
		<keyboard>
			<menu>RunPlugin(plugin://plugin.video.fefc/?action=fefcmenu)</menu>
			<c>RunPlugin(plugin://plugin.video.fefc/?action=fefcmenu)</c>
			<!-- Fire TV and Android send Back as keyboard escape / browser back.
			     The action is PreviousMenu only. A plugin call here swallows the key. -->
			<escape>PreviousMenu</escape>
			<backspace>PreviousMenu</backspace>
			<browser_back>PreviousMenu</browser_back>
		</keyboard>
		<remote>
			<menu>RunPlugin(plugin://plugin.video.fefc/?action=fefcmenu)</menu>
			<title>RunPlugin(plugin://plugin.video.fefc/?action=fefcmenu)</title>
			<select mod="longpress">RunPlugin(plugin://plugin.video.fefc/?action=fefcmenu)</select>
			<back>PreviousMenu</back>
		</remote>
		<gamepad>
			<back>PreviousMenu</back>
		</gamepad>
	</global>
	<!-- Play, pause, and scan become PlayerControl. The service then plays one
	     cue from the new player state. Leaving them as Play/Pause/FastForward
	     would also play the sound-skin action, so the cue would fire twice. -->
	<FullscreenVideo>
		<keyboard>
			<space>PlayerControl(Play)</space>
			<p>PlayerControl(Play)</p>
			<play_pause>PlayerControl(Play)</play_pause>
			<f>PlayerControl(Forward)</f>
			<r>PlayerControl(Rewind)</r>
		</keyboard>
		<remote>
			<play>PlayerControl(Play)</play>
			<pause>PlayerControl(Play)</pause>
			<playpause>PlayerControl(Play)</playpause>
			<forward>PlayerControl(Forward)</forward>
			<reverse>PlayerControl(Rewind)</reverse>
		</remote>
	</FullscreenVideo>
</keymap>
